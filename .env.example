# Copy to .env and fill with your Flywire Checkout V2 demo credentials.
# Get credentials from: https://checkout.demo.flywire.com/playground/
#
# Note: the CPX_* prefix is preserved for backwards compatibility; the
# product is publicly known as "Flywire Checkout V2".

# Public recipient credentials (sent to the browser via /api/config)
CPX_CLIENT_ID=
CPX_CODE=

# Server-only secret used to create authenticated sessions for tokenization (Save Card).
# Pay in Full and Reserve & Hold work without it; tokenization requires it.
CPX_API_KEY=

# Flywire Checkout V2 public API base URL.
# Defaults to https://checkout.demo.flywire.com/public-api-demo if unset.
# Stage:  https://checkout.stage.flywire.com/public-api-stage
# Prod:   https://checkout.flywire.com/public-api-prod
# CPX_API_BASE=https://checkout.demo.flywire.com/public-api-demo

# Optional; default 3000. Render sets PORT automatically.
# PORT=3000
