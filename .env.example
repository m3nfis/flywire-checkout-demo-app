# Copy to .env and fill with your Flywire Checkout V2 demo credentials.
# Get credentials from: https://checkout.demo.flywire.com/playground/
#
# Note: the CPX_* prefix is preserved for backwards compatibility; the
# product is publicly known as "Flywire Checkout V2".

# Public recipient credentials (sent to the browser via /api/config)
CPX_CLIENT_ID=
CPX_CODE=

# Server-only secret used to create and read authenticated sessions.
# Required for every tokenization flow; without it only anonymous payments work.
CPX_API_KEY=

# Flywire public API base URL. Defaults to the demo environment if unset.
# Demo: https://api-platform.demo.flywire.com
# Prod: https://api-platform.flywire.com
# CPX_API_BASE=https://api-platform.demo.flywire.com

# Optional: receive session events (webhooks) at this URL.
# CPX_EVENT_URL=https://your-app.example.com/flywire/events

# Optional: recipient codes that receive the "Split with partners" portions.
# Defaults to EVT,UUI (valid on the DTT demo recipient).
# CPX_SPLIT_RECIPIENTS=EVT,UUI

# Optional: enable capabilities that are not deployed to every environment yet.
# Supported: moto, timeout
# CPX_PREVIEW_FEATURES=moto,timeout

# Optional; default 3000. Render sets PORT automatically.
# PORT=3000
